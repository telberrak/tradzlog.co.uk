APP_ENV=local
DATABASE_URL=postgresql+psycopg://tradzlog:tradzlog@localhost:5432/tradzlog
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=tradzlog.local
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Screenshot storage: local (var/uploads) or s3 (private bucket; on EC2 credentials come from the instance role)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=eu-west-2
S3_PREFIX=
SENTRY_DSN=
LOG_LEVEL=INFO
AXIOM_TOKEN=
